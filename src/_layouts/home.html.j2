<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pascal Gagnon — Économie, Énergie &amp; PME du Québec</title>
<meta name="description" content="Pascal Gagnon observe l'économie, l'énergie et les PME du Québec depuis le terrain. Directeur de compte Desjardins Entreprise, conseiller municipal Roberval.">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --noir: #0a0a0a;
  --creme: #f5f0e8;
  --bleu: #0063b2;
  --bleu-clair: #4d92c9;
  --bleu-pale: #e6eff7;
  --gris: #6b6b6b;
  --gris-clair: #d4cfc6;
  --max: 1200px;
}
html { scroll-behavior: smooth; }
body { background: var(--creme); color: var(--noir); font-family: 'DM Sans', sans-serif; font-weight: 300; overflow-x: hidden; font-size: 18px; line-height: 1.7; }

/* ── NAV ── */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 1.4rem 4rem; background: rgba(245,240,232,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,99,178,0.15); }
.nav-logo { font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--noir); text-decoration: none; }
.nav-logo span { color: var(--bleu); }
.nav-links { display: flex; gap: 2.5rem; list-style: none; }
.nav-links a { font-size: 0.78rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gris); text-decoration: none; transition: color 0.3s; }
.nav-links a:hover { color: var(--bleu); }
.nav-cta { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.6rem 1.6rem; border: 1px solid var(--bleu); color: var(--bleu); text-decoration: none; transition: all 0.3s; }
.nav-cta:hover { background: var(--bleu); color: #fff; }
.nav-hamburger { display: none; background: none; border: none; cursor: pointer; padding: 0.4rem; }
.nav-hamburger span { display: block; width: 22px; height: 2px; background: var(--noir); margin: 5px 0; }
.nav-mobile { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--creme); z-index: 200; flex-direction: column; align-items: center; justify-content: center; gap: 2.5rem; }
.nav-mobile.ouvert { display: flex; }
.nav-mobile a { font-size: 0.9rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--noir); text-decoration: none; transition: color 0.3s; }
.nav-mobile a:hover { color: var(--bleu); }
.nav-mobile-close { position: absolute; top: 1.2rem; right: 1.5rem; background: none; border: none; cursor: pointer; font-size: 1.8rem; color: var(--gris); line-height: 1; padding: 0.4rem; }
@media (max-width: 768px) { nav { padding: 1rem 1.5rem; } .nav-links { display: none; } .nav-cta { display: none; } .nav-hamburger { display: block; } }

/* ── HERO ── */
.hero { min-height: 80vh; display: flex; align-items: center; padding-top: 80px; background: var(--creme); }
.hero-left { display: flex; flex-direction: column; justify-content: center; padding: 6rem 4rem; max-width: 820px; }
@media (max-width: 768px) { .hero-left { padding: 3rem 1.5rem; } }
.hero-eyebrow { font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--bleu-clair); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.8rem; }
.hero-eyebrow::before { content: ''; display: block; width: 40px; height: 1px; background: var(--bleu-clair); }
.hero-title { font-family: 'Playfair Display', serif; font-size: clamp(2.8rem, 4.5vw, 5rem); font-weight: 900; line-height: 1.0; margin-bottom: 0.3rem; color: var(--noir); letter-spacing: -0.02em; }
.hero-title em { font-style: italic; color: var(--bleu); }
.hero-subtitle { font-family: 'Playfair Display', serif; font-size: clamp(1.1rem, 1.6vw, 1.4rem); font-weight: 400; font-style: italic; color: var(--gris); margin-bottom: 1.8rem; margin-top: 0.5rem; }
.hero-eyeline { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bleu-clair); margin-bottom: 2.8rem; line-height: 1.5; }
.hero-actions { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; }
.btn-primary { background: var(--bleu); color: #fff; padding: 1rem 2.2rem; font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; transition: all 0.3s; font-family: 'DM Sans', sans-serif; border: 1px solid var(--bleu); }
.btn-primary:hover { background: var(--noir); border-color: var(--noir); color: #fff; }
.btn-secondary { font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris); text-decoration: none; transition: color 0.3s; }
.btn-secondary:hover { color: var(--bleu); }

/* ── DIVIDER ── */
.section-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--bleu-clair), transparent); margin: 0 4rem; opacity: 0.4; }

/* ── CONTENT BODY (sidebar + main) ── */
.content-body { max-width: var(--max); margin: 0 auto; display: grid; grid-template-columns: 210px 1fr; align-items: start; }
@media (max-width: 900px) { .content-body { grid-template-columns: 1fr; } }

/* ── SIDEBAR SYSTÈMES ── */
.sys-sidebar { position: sticky; top: 80px; padding: 2.5rem 1.2rem 2.5rem 4rem; border-right: 1px solid var(--gris-clair); max-height: calc(100vh - 80px); overflow-y: auto; }
@media (max-width: 900px) { .sys-sidebar { display: none; } }
.sidebar-label { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gris); margin-bottom: 1rem; }
.sidebar-sys-list { list-style: none; }
.sidebar-sys-list li { margin-bottom: 1px; }
.sidebar-sys-list a { display: flex; align-items: flex-start; gap: 8px; padding: 5px 8px; border-radius: 4px; font-size: 0.7rem; color: var(--noir); text-decoration: none; line-height: 1.3; transition: background 0.15s, color 0.15s; }
.sidebar-sys-list a:hover { background: var(--bleu-pale); color: var(--bleu); }
.sys-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 3px; }
.sidebar-explorer { display: block; margin-top: 1rem; padding: 0.7rem 8px 0; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bleu); text-decoration: none; font-weight: 500; border-top: 1px solid var(--gris-clair); transition: color 0.2s; }
.sidebar-explorer:hover { color: var(--bleu-clair); }

/* ── MAIN COLUMN ── */
.main-col { min-width: 0; }

/* ── ARTICLE VEDETTE ── */
.article-central { padding: 5rem 3.5rem; }
@media (max-width: 768px) { .article-central { padding: 4rem 1.5rem; } }
.section-label { font-size: 0.68rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--bleu-clair); display: block; margin-bottom: 2rem; }
.central-inner { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; align-items: start; }
@media (max-width: 768px) { .central-inner { grid-template-columns: 1fr; gap: 2rem; } }
.central-tag { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bleu); display: block; margin-bottom: 0.8rem; }
.central-temps { font-size: 0.82rem; color: var(--gris); }
.central-content h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 2.5vw, 2.6rem); font-weight: 700; line-height: 1.15; margin-bottom: 1.4rem; letter-spacing: -0.01em; }
.central-content h2 em { font-style: italic; color: var(--bleu); }
.central-chapeau { font-size: 1.05rem; line-height: 1.85; color: #3a3a3a; margin-bottom: 2rem; }
.central-lien { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bleu); text-decoration: underline; text-underline-offset: 4px; transition: color 0.2s; }
.central-lien:hover { color: var(--noir); }

/* ── ARTICLES RÉCENTS ── */
.articles-recents { padding: 0 3.5rem 6rem; }
@media (max-width: 768px) { .articles-recents { padding: 0 1.5rem 4rem; } }
.articles-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 3rem; border-top: 1px solid var(--gris-clair); padding-top: 2.5rem; }
.articles-header h2 { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; }
.voir-tout { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bleu); text-decoration: none; transition: letter-spacing 0.3s; }
.voir-tout:hover { letter-spacing: 0.22em; }
.articles-grille { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
@media (max-width: 600px) { .articles-grille { grid-template-columns: 1fr; gap: 2rem; } }
.article-card { display: flex; flex-direction: column; border-top: 2px solid var(--gris-clair); padding-top: 1.8rem; transition: border-color 0.25s; }
.article-card:hover { border-color: var(--bleu); }
.card-vertical { font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--bleu); margin-bottom: 0.8rem; }
.card-titre { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; line-height: 1.25; color: var(--noir); text-decoration: none; display: block; margin-bottom: 0.9rem; transition: color 0.2s; }
.article-card:hover .card-titre { color: var(--bleu); }
.card-extrait { font-size: 0.95rem; line-height: 1.75; color: #4a4a4a; margin-bottom: 1.2rem; flex: 1; }
.card-meta { font-size: 0.75rem; color: var(--gris); letter-spacing: 0.04em; }

/* ── SYSTÈMES MOBILE (caché sur desktop) ── */
.systemes-mobile { display: none; padding: 2.5rem 1.5rem 3rem; border-top: 1px solid var(--gris-clair); }
@media (max-width: 900px) { .systemes-mobile { display: block; } }
.sm-label { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gris); margin-bottom: 1rem; }
.sm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; margin-bottom: 1rem; }
.sm-grid a { display: flex; align-items: flex-start; gap: 7px; padding: 7px 8px; font-size: 0.72rem; color: var(--noir); text-decoration: none; border-radius: 4px; transition: background 0.15s; line-height: 1.3; }
.sm-grid a:hover { background: var(--bleu-pale); color: var(--bleu); }
.sm-explorer { display: inline-block; margin-top: 0.8rem; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bleu); text-decoration: none; font-weight: 500; }

/* ── INFOLETTRE ── */
.newsletter { padding: 7rem 4rem; border-top: 1px solid var(--gris-clair); }
@media (max-width: 768px) { .newsletter { padding: 4rem 1.5rem; } }
.newsletter-inner { max-width: 520px; margin: 0 auto; text-align: center; }
.nl-h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 2.6vw, 2.3rem); font-weight: 700; line-height: 1.2; color: var(--noir); margin-bottom: 1rem; letter-spacing: -0.01em; }
.nl-h2 em { font-style: italic; color: var(--bleu); }
.nl-desc { font-size: 1rem; line-height: 1.85; color: var(--gris); margin-bottom: 2.4rem; }
.nl-form { display: flex; flex-direction: column; gap: 0.8rem; }
.nl-form input { background: transparent; border: 1px solid var(--gris-clair); padding: 0.95rem 1.2rem; font-size: 1rem; color: var(--noir); font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.2s; text-align: center; }
.nl-form input::placeholder { color: var(--gris-clair); }
.nl-form input:focus { border-color: var(--bleu); }
.nl-form button { background: var(--bleu); color: #fff; border: none; padding: 1rem 1.2rem; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; font-family: 'DM Sans', sans-serif; cursor: pointer; transition: all 0.25s; }
.nl-form button:hover { background: var(--noir); }
.nl-note { font-size: 0.72rem; color: var(--gris-clair); margin-top: 0.6rem; }

/* ── FOOTER ── */
footer { background: var(--noir); padding: 2.5rem 4rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
@media (max-width: 768px) { footer { padding: 2rem 1.5rem; flex-direction: column; align-items: flex-start; } }
.footer-logo { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: rgba(245,240,232,0.5); text-decoration: none; }
.footer-logo span { color: var(--bleu-clair); }
.footer-links { display: flex; gap: 2rem; list-style: none; flex-wrap: wrap; }
.footer-links a { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,232,0.3); text-decoration: none; transition: color 0.2s; }
.footer-links a:hover { color: var(--bleu-clair); }
.footer-ref { font-size: 0.65rem; color: rgba(245,240,232,0.18); font-style: italic; }
.footer-copy { font-size: 0.65rem; color: rgba(245,240,232,0.2); }

/* ── ANIMATIONS ── */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" class="nav-logo">Pascal<span>.</span>Gagnon</a>
  <ul class="nav-links">
    <li><a href="/systemes/explorer.html">Explorer</a></li>
  </ul>
  <a href="#newsletter" class="nav-cta">Infolettre</a>
  <button class="nav-hamburger" onclick="toggleMenu()" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
</nav>
<!-- MENU MOBILE -->
<div class="nav-mobile" id="navMobile">
  <button class="nav-mobile-close" onclick="toggleMenu()" aria-label="Fermer">&times;</button>
  <a href="/systemes/explorer.html" onclick="toggleMenu()">Explorer</a>
  <a href="#newsletter" onclick="toggleMenu()" style="margin-top:1rem;color:var(--bleu);border:1px solid var(--bleu);padding:0.7rem 1.8rem;font-size:0.78rem;letter-spacing:0.1em;">Infolettre</a>
</div>

<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <p class="hero-eyebrow">Directeur de compte Desjardins Entreprise · Conseiller municipal, Roberval</p>
    <h1 class="hero-title">Le Lac-Saint-Jean<br><em>se transforme.</em></h1>
    <p class="hero-subtitle">J'observe depuis l'intérieur, j'écris ce que je vois.</p>
    <p class="hero-eyeline">12 systèmes de pensée &nbsp;·&nbsp; Économie &amp; Énergie &nbsp;·&nbsp; IA &nbsp;·&nbsp; Santé &nbsp;·&nbsp; Géopolitique</p>
    <div class="hero-actions">
      <a href="/systemes/explorer.html" class="btn-primary">Explorer les systèmes</a>
      <a href="#newsletter" class="btn-secondary">Infolettre →</a>
    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- CONTENU : SIDEBAR + MAIN -->
<div class="content-body">

  <!-- SIDEBAR GAUCHE — 12 systèmes (desktop uniquement) -->
  <aside class="sys-sidebar">
    <div class="sidebar-label">Systèmes de pensée</div>
    <ul class="sidebar-sys-list">
      <li><a href="/systemes/c1/"><span class="sys-dot" style="background:#0063b2"></span>Persuasion &amp; Marketing</a></li>
      <li><a href="/systemes/c2/"><span class="sys-dot" style="background:#1a85d6"></span>Biophysique &amp; Intelligence</a></li>
      <li><a href="/systemes/c3/"><span class="sys-dot" style="background:#2c5f8a"></span>IA &amp; Contenu</a></li>
      <li><a href="/systemes/c4/"><span class="sys-dot" style="background:#0080cc"></span>IA &amp; Économie Politique</a></li>
      <li><a href="/systemes/c5/"><span class="sys-dot" style="background:#c0392b"></span>Guerre &amp; Géopolitique</a></li>
      <li><a href="/systemes/c6/"><span class="sys-dot" style="background:#8e44ad"></span>Métabolisme &amp; Santé</a></li>
      <li><a href="/systemes/c7/"><span class="sys-dot" style="background:#16a085"></span>Géographie &amp; Densité</a></li>
      <li><a href="/systemes/c8/"><span class="sys-dot" style="background:#2980b9"></span>Communication &amp; Storytelling</a></li>
      <li><a href="/systemes/c9/"><span class="sys-dot" style="background:#d35400"></span>Innovation &amp; Énergie</a></li>
      <li><a href="/systemes/c10/"><span class="sys-dot" style="background:#7f8c8d"></span>Linguistique &amp; Histoire</a></li>
      <li><a href="/systemes/c11/"><span class="sys-dot" style="background:#27ae60"></span>Organisation &amp; Culture</a></li>
      <li><a href="/systemes/c12/"><span class="sys-dot" style="background:#e67e22"></span>EROEI &amp; Transition</a></li>
    </ul>
    <a href="/systemes/explorer.html" class="sidebar-explorer">Explorer la carte →</a>
  </aside>

  <!-- COLONNE PRINCIPALE -->
  <div class="main-col">

    <!-- ARTICLE VEDETTE -->
    <section class="article-central reveal">
      <span class="section-label">À lire en premier ——</span>
      <div class="central-inner">
        <div>
          <span class="central-tag">◆ {{ articles.featured.vertical }}</span>
          <span class="central-temps">Lecture : ~{{ articles.featured.reading_time }}</span>
        </div>
        <div class="central-content">
          <h2>{{ articles.featured.title }}</h2>
          <p class="central-chapeau">{{ articles.featured.chapeau }}</p>
          <a href="{{ articles.featured.url if articles.featured.url else '/articles/' + articles.featured.slug + '/' }}" class="central-lien">Lire l'article →</a>
        </div>
      </div>
    </section>

    <div class="section-divider" style="margin:0 3.5rem;"></div>

    <!-- ARTICLES RÉCENTS -->
    <section class="articles-recents reveal">
      <div class="articles-header">
        <h2>Articles récents</h2>
        <a href="/systemes/explorer.html" class="voir-tout">Explorer →</a>
      </div>
      <div class="articles-grille">
        {% for article in articles.recent %}
        <article class="article-card">
          <span class="card-vertical">{{ article.vertical }}</span>
          <a href="{{ article.url if article.url else '/articles/' + article.slug + '/' }}" class="card-titre">{{ article.title }}</a>
          <p class="card-extrait">{{ article.chapeau }}</p>
          <span class="card-meta">{{ article.date }} &nbsp;·&nbsp; {{ article.reading_time }}</span>
        </article>
        {% endfor %}
      </div>
    </section>

    <!-- SYSTÈMES MOBILE (caché sur desktop, affiché sur mobile sous les articles) -->
    <section class="systemes-mobile">
      <div class="sm-label">12 systèmes de pensée</div>
      <div class="sm-grid">
        <a href="/systemes/c1/"><span class="sys-dot" style="background:#0063b2"></span>Persuasion &amp; Marketing</a>
        <a href="/systemes/c2/"><span class="sys-dot" style="background:#1a85d6"></span>Biophysique &amp; Intelligence</a>
        <a href="/systemes/c3/"><span class="sys-dot" style="background:#2c5f8a"></span>IA &amp; Contenu</a>
        <a href="/systemes/c4/"><span class="sys-dot" style="background:#0080cc"></span>IA &amp; Économie Politique</a>
        <a href="/systemes/c5/"><span class="sys-dot" style="background:#c0392b"></span>Guerre &amp; Géopolitique</a>
        <a href="/systemes/c6/"><span class="sys-dot" style="background:#8e44ad"></span>Métabolisme &amp; Santé</a>
        <a href="/systemes/c7/"><span class="sys-dot" style="background:#16a085"></span>Géographie &amp; Densité</a>
        <a href="/systemes/c8/"><span class="sys-dot" style="background:#2980b9"></span>Communication &amp; Storytelling</a>
        <a href="/systemes/c9/"><span class="sys-dot" style="background:#d35400"></span>Innovation &amp; Énergie</a>
        <a href="/systemes/c10/"><span class="sys-dot" style="background:#7f8c8d"></span>Linguistique &amp; Histoire</a>
        <a href="/systemes/c11/"><span class="sys-dot" style="background:#27ae60"></span>Organisation &amp; Culture</a>
        <a href="/systemes/c12/"><span class="sys-dot" style="background:#e67e22"></span>EROEI &amp; Transition</a>
      </div>
      <a href="/systemes/explorer.html" class="sm-explorer">Explorer la carte complète →</a>
    </section>

  </div><!-- /.main-col -->
</div><!-- /.content-body -->

<div class="section-divider"></div>

<!-- INFOLETTRE -->
<section class="newsletter reveal" id="newsletter">
  <div class="newsletter-inner">
    <span class="section-label">Infolettre ——</span>
    <h2 class="nl-h2">Une idée par semaine,<em> le vendredi matin.</em></h2>
    <p class="nl-desc">Pas de digest, pas de liste de ressources. Une lettre — une idée développée sur l'économie, l'énergie, l'IA ou la culture entrepreneuriale du Québec. Contrat 90 jours : si tu n'ouvres rien, tu sors.</p>
    <form class="nl-form" id="nl-form" novalidate>
      <input type="text" id="nl-prenom" name="prenom" placeholder="Votre prénom" autocomplete="given-name">
      <input type="email" id="nl-email" name="email" placeholder="Votre courriel" autocomplete="email">
      <button type="submit" id="nl-btn">Je m'abonne</button>
      <p class="nl-note" id="nl-feedback" style="display:none;"></p>
      <p class="nl-note">Désabonnement en un clic. Conforme à la Loi 25.</p>
    </form>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <a href="/" class="footer-logo">Pascal<span>.</span>Gagnon</a>
  <ul class="footer-links">
    <li><a href="https://www.linkedin.com/in/pascalgagnon/" target="_blank">LinkedIn</a></li>
    <li><a href="/systemes/explorer.html">Explorer</a></li>
    <li><a href="https://histoire.pascalgagnon.ca/">Histoire · Saints</a></li>
    <li><a href="/a-propos/">À propos</a></li>
  </ul>
  <span class="footer-ref">12 systèmes de pensée · Lac-Saint-Jean</span>
  <p class="footer-copy">© 2026 Pascal Gagnon</p>
</footer>

<script>
function toggleMenu() {
  var m = document.getElementById('navMobile');
  m.classList.toggle('ouvert');
  document.body.style.overflow = m.classList.contains('ouvert') ? 'hidden' : '';
}
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

/* ── INFOLETTRE — fetch vers N8N ── */
(function() {
  // ⚠️ Remplacer par l'URL du webhook N8N une fois le workflow activé
  var N8N_WEBHOOK_URL = 'https://n8n.pascalgagnon.ca/webhook/brevo-subscribe';

  var form     = document.getElementById('nl-form');
  var btn      = document.getElementById('nl-btn');
  var feedback = document.getElementById('nl-feedback');

  if (!form) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    var prenom = document.getElementById('nl-prenom').value.trim();
    var email  = document.getElementById('nl-email').value.trim();

    if (!prenom || !email) {
      showFeedback('Merci de remplir ton prénom et ton courriel.', false);
      return;
    }

    btn.textContent = 'Envoi…';
    btn.disabled = true;
    hideFeedback();

    fetch(N8N_WEBHOOK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prenom: prenom, email: email })
    })
    .then(function(res) {
      if (res.ok) {
        showFeedback('Vérifie ton courriel — un lien de confirmation t\'attend.', true);
        form.reset();
      } else {
        throw new Error('Erreur ' + res.status);
      }
    })
    .catch(function() {
      showFeedback('Une erreur s\'est produite. Réessaie dans un moment.', false);
    })
    .finally(function() {
      btn.textContent = 'Je m\'abonne';
      btn.disabled = false;
    });
  });

  function showFeedback(msg, success) {
    feedback.textContent = msg;
    feedback.style.color   = success ? 'var(--bleu)' : '#c0392b';
    feedback.style.display = 'block';
  }
  function hideFeedback() {
    feedback.style.display = 'none';
  }
})();
</script>
</body>
</html>
