<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ system.name }} — Système {{ system.id|upper }} · Pascal Gagnon</title>
<meta name="description" content="{{ system.description }}">
<link rel="canonical" href="https://pascalgagnon.ca/systemes/{{ system.id }}/">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --noir: #0a0a0a;
  --creme: #f5f0e8;
  --bleu: #0063b2;
  --bleu-clair: #4d92c9;
  --bleu-pale: #e6eff7;
  --gris: #6b6b6b;
  --gris-clair: #d4cfc6;
  --sys-color: {{ system.color }};
  --max: 860px;
}
html { scroll-behavior: smooth; }
body { background: var(--creme); color: var(--noir); font-family: 'DM Sans', sans-serif; font-weight: 300; overflow-x: hidden; font-size: 18px; line-height: 1.75; }

/* ── NAV ── */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 1.4rem 4rem; background: rgba(245,240,232,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,99,178,0.15); }
.nav-logo { font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--noir); text-decoration: none; }
.nav-logo span { color: var(--bleu); }
.nav-links { display: flex; gap: 2.5rem; list-style: none; }
.nav-links a { font-size: 0.78rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gris); text-decoration: none; transition: color 0.3s; }
.nav-links a:hover, .nav-links a.active { color: var(--bleu); }
@media (max-width: 768px) { nav { padding: 1rem 1.5rem; } .nav-links { display: none; } }

/* ── HERO SYSTÈME ── */
.hero {
  background: var(--noir);
  color: #fff;
  padding: 6rem 2rem 4.5rem;
  padding-top: calc(6rem + 80px);
  position: relative;
  overflow: hidden;
}
.hero::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.02) 39px, rgba(255,255,255,0.02) 40px); }
.hero-accent { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--sys-color); }
.hero-inner { position: relative; max-width: var(--max); margin: 0 auto; }
.hero-eyebrow { font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--sys-color); margin-bottom: 1.4rem; display: flex; align-items: center; gap: 0.8rem; }
.hero-eyebrow::before { content: ''; display: block; width: 40px; height: 1px; background: var(--sys-color); }
.hero-code { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 0.5rem; }
.hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; font-weight: 900; margin-bottom: 1.5rem; letter-spacing: -0.02em; }
.hero-desc { font-size: 1.05rem; color: rgba(255,255,255,0.65); line-height: 1.7; max-width: 600px; margin-bottom: 2rem; }
.hero-stats { display: flex; gap: 2.5rem; flex-wrap: wrap; }
.stat { }
.stat-val { font-size: 1.8rem; font-weight: 700; font-family: 'Playfair Display', serif; color: var(--sys-color); line-height: 1; }
.stat-label { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-top: 0.3rem; }

/* ── RETOUR ── */
.retour-bar { background: var(--creme); padding: 1rem 2rem; border-bottom: 1px solid var(--gris-clair); position: sticky; top: 80px; z-index: 90; display: flex; gap: 2rem; }
.retour-bar a { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gris); text-decoration: none; transition: color 0.2s; }
.retour-bar a:hover { color: var(--bleu); }
@media (max-width: 600px) { .retour-bar { display: none; } }

/* ── CONTENU ── */
.systeme-wrap { max-width: var(--max); margin: 0 auto; padding: 4rem 2rem 6rem; }

/* Section articles */
.section-label { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gris); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; }
.section-label::after { content: ''; flex: 1; height: 1px; background: var(--gris-clair); }

/* Grille articles */
.articles-grid { display: grid; gap: 1.5rem; margin-bottom: 4rem; }

/* Carte article */
.article-card {
  background: #fff;
  border: 1px solid var(--gris-clair);
  border-top: 3px solid var(--sys-color);
  padding: 1.8rem 2rem;
  text-decoration: none;
  color: var(--noir);
  display: block;
  transition: transform 0.2s, box-shadow 0.2s;
}
.article-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,0.08); }
.card-eyebrow { font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gris); margin-bottom: 0.7rem; }
.card-title { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; line-height: 1.2; margin-bottom: 0.8rem; letter-spacing: -0.01em; }
.card-desc { font-size: 0.9rem; color: var(--gris); line-height: 1.6; margin-bottom: 1rem; }
.card-meta { font-size: 0.68rem; color: var(--gris); letter-spacing: 0.08em; display: flex; gap: 1.5rem; }
.card-lire { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sys-color); font-weight: 500; }

/* Message vide */
.articles-empty {
  background: var(--bleu-pale);
  border: 1px solid rgba(0,99,178,0.15);
  border-left: 3px solid var(--sys-color);
  padding: 1.5rem 2rem;
  font-size: 0.9rem; color: var(--gris); line-height: 1.6;
}

/* CTA Explorer */
.explorer-cta {
  background: var(--noir);
  color: #fff;
  padding: 2.5rem 2rem;
  display: flex; align-items: center; justify-content: space-between;
  gap: 1.5rem; flex-wrap: wrap;
  border-radius: 4px;
  margin-top: 2rem;
}
.cta-text h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.4rem; }
.cta-text p { font-size: 0.85rem; color: rgba(255,255,255,0.5); }
.cta-btn { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.7rem 1.8rem; border: 1px solid var(--sys-color); color: var(--sys-color); text-decoration: none; font-weight: 500; white-space: nowrap; transition: all 0.2s; }
.cta-btn:hover { background: var(--sys-color); color: #fff; }

/* ── FOOTER ── */
footer { background: var(--noir); padding: 2.5rem 4rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
@media (max-width: 768px) { footer { padding: 2rem 1.5rem; } }
.footer-logo { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: rgba(245,240,232,0.5); text-decoration: none; }
.footer-logo span { color: var(--bleu-clair); }
.footer-copy { font-size: 0.65rem; color: rgba(245,240,232,0.2); }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" class="nav-logo">Pascal<span>.</span>Gagnon</a>
  <ul class="nav-links">
    <li><a href="/systemes/explorer.html" class="active">Explorer</a></li>
  </ul>
  <a href="/#newsletter" class="nav-cta" style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.55rem 1.4rem;border:1px solid var(--bleu);color:var(--bleu);text-decoration:none;font-weight:500;transition:all 0.2s;">Infolettre</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-accent"></div>
  <div class="hero-inner">
    <p class="hero-eyebrow">Système de pensée</p>
    <p class="hero-code">{{ system.id|upper }}</p>
    <h1>{{ system.name }}</h1>
    <p class="hero-desc">{{ system.description }}</p>
    <div class="hero-stats">
      <div class="stat">
        <div class="stat-val">{{ articles|length }}</div>
        <div class="stat-label">Articles publiés</div>
      </div>
      <div class="stat">
        <div class="stat-val">{{ system.concepts }}</div>
        <div class="stat-label">Concepts atomiques</div>
      </div>
      <div class="stat">
        <div class="stat-val">{{ system.tags }}</div>
        <div class="stat-label">Connexions dans le vault</div>
      </div>
    </div>
  </div>
</section>

<!-- RETOUR -->
<div class="retour-bar">
  <a href="/systemes/explorer.html">← Explorer tous les systèmes</a>
  <a href="/">Accueil</a>
</div>

<!-- CONTENU -->
<div class="systeme-wrap">

  <div class="section-label">Articles publiés dans ce système</div>

  {% if articles %}
  <div class="articles-grid">
    {% for article in articles %}
    <a href="/{{ article.src_dir }}/{{ article.slug }}/" class="article-card">
      <div class="card-eyebrow">{{ article.vertical or system.name }} {% if article.tag %}&nbsp;·&nbsp; {{ article.tag }}{% endif %}</div>
      <div class="card-title">{{ article.title }}</div>
      <div class="card-desc">{{ article.description }}</div>
      <div class="card-meta">
        <span>{{ article.date }}</span>
        {% if article.reading_time %}<span>{{ article.reading_time }} de lecture</span>{% endif %}
        <span class="card-lire">Lire l'article →</span>
      </div>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="articles-empty">
    <strong>Aucun article publié dans ce système pour l'instant.</strong><br>
    Les premiers articles de ce système sont en préparation. Revenez bientôt, ou <a href="/systemes/explorer.html" style="color:var(--bleu)">explorez un autre système</a>.
  </div>
  {% endif %}

  <div class="explorer-cta">
    <div class="cta-text">
      <h3>Explorer les 12 systèmes</h3>
      <p>Voir comment les idées se connectent entre les systèmes — carte interactive.</p>
    </div>
    <a href="/systemes/explorer.html" class="cta-btn">Ouvrir l'Explorer →</a>
  </div>

</div>

<!-- FOOTER -->
<footer>
  <a href="/" class="footer-logo">Pascal<span>.</span>Gagnon</a>
  <p class="footer-copy">© 2026 Pascal Gagnon · Lac-Saint-Jean</p>
</footer>

</body>
</html>
